            )
        );
    }

    const tokenHash =
        crypto
            .createHash("sha256")
            .update(token)
            .digest("hex");

    const result = await query(`
        SELECT id
        FROM reset_tokens
        WHERE token_hash = $1
          AND used = FALSE
          AND expires_at > NOW()
        LIMIT 1
    `, [tokenHash]);

    if (!result.rows.length) {
        return res.status(400).send(
            page("Invalid reset link", `
                <div class="error">
                    This reset link is invalid or expired.
                </div>

                <a href="/forgot-password">
